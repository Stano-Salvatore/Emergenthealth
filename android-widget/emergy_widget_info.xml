<?xml version="1.0" encoding="utf-8"?>
<!-- No updatePeriodMillis: this widget shows nothing that can go stale. It is
     two buttons that launch the app, so there is never anything to refresh. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_emergy"
    android:previewLayout="@layout/widget_emergy"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
