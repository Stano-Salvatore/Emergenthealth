<?xml version="1.0" encoding="utf-8"?>
<!--
  The expanded chat window. Rounded to match the head it grows out of, and
  opaque: a translucent panel over someone else's app makes both unreadable.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#13122B" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#312E81" />
</shape>
