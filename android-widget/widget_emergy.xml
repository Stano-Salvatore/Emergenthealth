<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EMERGY"
        android:textColor="#818CF8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:layout_marginBottom="10dp" />

    <!-- The whole point of the widget: big enough to hit without looking. -->
    <TextView
        android:id="@+id/emergy_mic"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="52dp"
        android:gravity="center"
        android:text="🎤  Talk"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:background="@drawable/widget_button_primary" />

    <TextView
        android:id="@+id/emergy_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:gravity="center"
        android:text="Type instead"
        android:textColor="#C7D2FE"
        android:textSize="13sp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_button" />
</LinearLayout>
