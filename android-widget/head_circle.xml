<?xml version="1.0" encoding="utf-8"?>
<!--
  The chat head's own backing. Same #13122B on a #312E81 hairline as the app's
  cards and the widgets, so the thing floating over another app still reads as
  this app rather than as a stray system icon.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="#13122B" />
    <stroke android:width="1dp" android:color="#312E81" />
</shape>
