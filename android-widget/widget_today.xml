<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews supports a small set of views, so this stays plain: nested
     LinearLayouts and TextViews only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Today"
            android:textColor="#A5B4FC"
            android:textSize="12sp"
            android:maxLines="1" />
        <TextView
            android:id="@+id/today_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="…"
            android:textColor="#7A7A96"
            android:textSize="10sp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Readiness" android:textColor="#7A7A96" android:textSize="9sp" />
            <TextView
                android:id="@+id/today_readiness"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="#34D399" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Sleep" android:textColor="#7A7A96" android:textSize="9sp" />
            <TextView
                android:id="@+id/today_sleep"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="#818CF8" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Steps" android:textColor="#7A7A96" android:textSize="9sp" />
            <TextView
                android:id="@+id/today_steps"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="#FBBF24" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Habits" android:textColor="#7A7A96" android:textSize="9sp" />
            <TextView
                android:id="@+id/today_habits"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="#4ADE80" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/today_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="#F472B6"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
