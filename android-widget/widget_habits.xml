<?xml version="1.0" encoding="utf-8"?>
<!--
  One visual system across every widget: the app's card, a letter-spaced label
  in the app's indigo, and rows with room to breathe. The previous version used
  monospace at 13sp with emoji checkboxes, which read as a debug view.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/btn_habits_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HABITS"
            android:textColor="#A5B4FC"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:textStyle="bold"
            android:maxLines="1" />
        <TextView
            android:id="@+id/habits_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#F2F2FA"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/habit_row_0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true">
        <TextView
            android:id="@+id/habit_check_0"
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:text="○"
            android:textColor="#7A7A96"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/habit_name_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#E6E6F0"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/habit_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true">
        <TextView
            android:id="@+id/habit_check_1"
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:text="○"
            android:textColor="#7A7A96"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/habit_name_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#E6E6F0"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/habit_row_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true">
        <TextView
            android:id="@+id/habit_check_2"
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:text="○"
            android:textColor="#7A7A96"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/habit_name_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#E6E6F0"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/habit_row_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true">
        <TextView
            android:id="@+id/habit_check_3"
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:text="○"
            android:textColor="#7A7A96"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/habit_name_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#E6E6F0"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/habit_row_4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true">
        <TextView
            android:id="@+id/habit_check_4"
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:text="○"
            android:textColor="#7A7A96"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/habit_name_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#E6E6F0"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
