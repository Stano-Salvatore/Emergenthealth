generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth.js v5 tables ───────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  digestDay     Int       @default(1)
  digestHour    Int       @default(8)

  accounts             Account[]
  sessions             Session[]
  healthLogs           HealthLog[]
  transactions         Transaction[]
  habits               Habit[]
  reminders            Reminder[]
  chatMessages         ChatMessage[]
  chatConversations    ChatConversation[]
  mcpApiKeys           McpApiKey[]
  fitToken             FitToken?
  ouraToken            OuraToken?            @relation("OuraToken")
  ouraTags             OuraTag[]
  moodLogs             MoodLog[]
  tags                 Tag[]
  checkIns             CheckIn[]
  savedPlaces          SavedPlace[]
  dailyNotes           DailyNote[]
  intakeLogs           IntakeLog[]
  foodLogs             FoodLog[]
  symptomLogs          SymptomLog[]
  experiments          Experiment[]
  medSchedules         MedSchedule[]
  focusSessions        FocusSession[]
  driveImportLogs      DriveImportLog[]
  books                Book[]
  morningCheckIns      MorningCheckIn[]
  weatherLogs          WeatherLog[]
  userPreferences      UserPreference[]
  labResults           LabResult[]
  bodyMeasurements     BodyMeasurement[]
  habitRoutines        HabitRoutine[]
  subscription         Subscription?
  passkeys             Passkey[]
  locationPoints       LocationPoint[]
  goals                UserGoals?
  caffeineLog          CaffeineLog[]
  stravaToken          StravaToken?
  stravaActivities     StravaActivity[]
  ynabToken            YnabToken?
  feedbacks            UserFeedback[]
  timelineEvents       TimelineEvent[]
  screenTimeLogs       ScreenTimeLog[]
  deviceCalendarEvents DeviceCalendarEvent[]
  bloodPressureLogs    BloodPressureLog[]
  customMetrics        CustomMetric[]
  customMetricLogs     CustomMetricLog[]
  fcmTokens            FcmToken[]
  githubProfile        GitHubProfile?
  lastfmKey            LastfmKey?
  lastfmLogs           LastfmLog[]
  rescuetimeKey        RescuetimeKey?
  rescuetimeLogs       RescuetimeLog[]
  togglToken           TogglToken?
  activitySpans        ActivitySpan[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Health ──────────────────────────────────────────────────────────────────

model HealthLog {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date

  sleepStart    DateTime?
  sleepEnd      DateTime?
  sleepDuration Int?
  deepSleep     Int?
  remSleep      Int?
  lightSleep    Int?

  steps          Int?
  caloriesBurned Int?
  activeMinutes  Int?

  workouts  Json?
  restingHR Int?
  weight    Float?

  // Oura extended metrics
  readinessScore       Int?
  hrv                  Float?
  spo2                 Float?
  skinTemp             Float?
  sleepEfficiency      Int?
  sleepLatency         Int?
  stressHigh           Int?
  totalCalories        Int?
  distanceKm           Float?
  // Oura v2 additional metrics
  breathingRate        Float?
  awakeTime            Int?
  timeInBed            Int?
  restlessPeriods      Int?
  activityScore        Int?
  recoveryHigh         Int?
  sedentaryTime        Int?
  breathingDisturbance Float?
  sleepScore           Int?

  syncedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// ─── Finances ────────────────────────────────────────────────────────────────

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  actualId      String?  @unique
  date          DateTime @db.Date
  amount        Int
  payee         String?
  category      String?
  categoryGroup String?
  accountName   String?
  notes         String?
  cleared       Boolean  @default(false)
  isTransfer    Boolean  @default(false)
  syncedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, category])
}

// ─── Drive Import Log ────────────────────────────────────────────────────────

model DriveImportLog {
  id         String   @id @default(cuid())
  userId     String
  fileId     String
  fileName   String
  importedAt DateTime @default(now())
  rowCount   Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fileId])
  @@index([userId])
}

// ─── Device Calendar (native Android read: Samsung / local / any account) ────

model DeviceCalendarEvent {
  id          String    @id @default(cuid())
  userId      String
  externalId  String // event id from the device Calendar Provider
  calendarId  String? // owning device calendar (account) id
  title       String
  description String?   @db.Text
  location    String?
  color       String? // hex, from the event's or its calendar's color
  start       DateTime
  end         DateTime?
  isAllDay    Boolean   @default(false)
  syncedAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId])
  @@index([userId, start])
}

// ─── Habits ──────────────────────────────────────────────────────────────────

model Habit {
  id           String   @id @default(cuid())
  userId       String
  name         String
  description  String?
  color        String   @default("#6366f1")
  icon         String?
  reminderTime String?
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  completions HabitCompletion[]
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HabitCompletion {
  id          String   @id @default(cuid())
  habitId     String
  userId      String
  date        DateTime @db.Date
  completedAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
  @@index([userId, date])
}

// ─── Reminders ───────────────────────────────────────────────────────────────

model Reminder {
  id           String    @id @default(cuid())
  userId       String
  title        String
  description  String?
  dueDate      DateTime?
  reminderTime String?
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?
  priority     String    @default("normal")
  tags         String[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@index([userId, isCompleted])
}

// ─── Mood ────────────────────────────────────────────────────────────────────

model MoodLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  mood      Int // 1–5: 1=awful, 2=bad, 3=ok, 4=good, 5=great
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// ─── Tags ────────────────────────────────────────────────────────────────────

model Tag {
  id     String @id @default(cuid())
  userId String
  name   String
  color  String @default("#6366f1")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

// ─── Check-ins ───────────────────────────────────────────────────────────────

model CheckIn {
  id           String   @id @default(cuid())
  userId       String
  place        String
  emoji        String   @default("📍")
  note         String?
  checkedAt    DateTime @default(now())
  isAuto       Boolean  @default(false)
  savedPlaceId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, checkedAt])
}

// ─── Saved Places ─────────────────────────────────────────────────────────────

model SavedPlace {
  id        String   @id @default(cuid())
  userId    String
  name      String
  emoji     String   @default("📍")
  address   String?
  lat       Float
  lng       Float
  radiusM   Int      @default(100)
  // the user's usual order here — one tap logs it when they arrive
  usualType String? // IntakeLog type, e.g. "coffee"
  usualMl   Int?
  usualNote String? // e.g. "Flat white"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Daily Notes ─────────────────────────────────────────────────────────────

model DailyNote {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  content   String   @db.Text
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// ─── Intake Log (water / coffee / etc.) ─────────────────────────────────────

model IntakeLog {
  id       String   @id @default(cuid())
  userId   String
  type     String // "water" | "coffee" | "tea" | "alcohol" | "other"
  amountMl Int
  note     String?
  loggedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

// ─── Food Log (meals, photo-analyzed) ────────────────────────────────────────

model FoodLog {
  id       String   @id @default(cuid())
  userId   String
  name     String // short meal name, e.g. "Chicken caesar salad"
  mealType String   @default("other") // "breakfast" | "lunch" | "dinner" | "snack" | "other"
  calories Int
  proteinG Float?
  carbsG   Float?
  fatG     Float?
  sugarG   Float?
  items    Json? // [{ kind, name, portion, calories, proteinG, carbsG, fatG, drinkType, volumeMl }]
  micros   Json? // [{ name, amount, unit, dailyPct }] — notable vitamins & minerals
  note     String? // one-line health note from the photo analysis
  photo    String?  @db.Text // small JPEG data-URL thumbnail for the log list
  lat      Float? // where the meal was logged (best-effort)
  lng      Float?
  place    String? // reverse-geocoded label, e.g. "Karlova Ves, Bratislava"
  loggedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

// ─── Reading Tracker ─────────────────────────────────────────────────────────

model Book {
  id         String    @id @default(cuid())
  userId     String
  title      String
  author     String?
  pages      Int?
  status     String    @default("reading") // "reading" | "done" | "wishlist"
  rating     Int? // 1-5
  startedAt  DateTime?
  finishedAt DateTime?
  notes      String?
  coverColor String    @default("#6366f1")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ─── Native Screen-Time ──────────────────────────────────────────────────────

model ScreenTimeLog {
  id             String   @id @default(cuid())
  userId         String
  date           String // local "YYYY-MM-DD"
  totalMin       Int // total foreground screen time that day
  firstUnlockMin Int? // minutes after local midnight of first phone unlock (wake proxy)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// ─── Custom Timeline Events ──────────────────────────────────────────────────

model TimelineEvent {
  id         String   @id @default(cuid())
  userId     String
  emoji      String   @default("📌")
  label      String
  note       String?
  imageData  String?  @db.Text // optional compressed photo, base64 data URL
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
}

// ─── Focus Sessions (Pomodoro) ───────────────────────────────────────────────

model FocusSession {
  id          String   @id @default(cuid())
  userId      String
  durationMin Int
  type        String   @default("focus") // "focus" | "short_break" | "long_break"
  label       String?
  startedAt   DateTime
  endedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endedAt])
}

// ─── Chat ────────────────────────────────────────────────────────────────────

model ChatMessage {
  id             String   @id @default(cuid())
  userId         String
  conversationId String?
  role           String
  content        String   @db.Text
  // The source chips behind an assistant reply, as JSON. Stored so reopening a
  // past chat shows the same receipts it showed live — an answer that loses its
  // working on reload is a weaker answer.
  sources        String?  @db.Text
  createdAt      DateTime @default(now())

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation ChatConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
}

model ChatConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
}

// ─── MCP / Google Fit ────────────────────────────────────────────────────────

model McpApiKey {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  name      String   @default("Default")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FitToken {
  id           String    @id @default(cuid())
  userId       String    @unique
  accessToken  String    @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime?
  scope        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OuraTag {
  id        String   @id
  userId    String
  day       String
  timestamp DateTime
  tagName   String?
  text      String?
  tags      String[]
  /// How much was taken. Null means the label said nothing about quantity —
  /// which is not the same as one tablet, and is never assumed to be.
  doseAmount Float?
  /// "mg" (absolute) or "tablet" (a share of an unknown strength). The two are
  /// never converted into one another.
  doseUnit   String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, day])
}

model OuraToken {
  id           String    @id @default(cuid())
  userId       String    @unique
  accessToken  String    @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime?
  scope        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation("OuraToken", fields: [userId], references: [id], onDelete: Cascade)
}

model MorningCheckIn {
  id          String   @id
  userId      String
  date        String
  energy      Int
  mood        Int
  intention   String?
  waterGoalMl Int      @default(2000)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model WeatherLog {
  id          String @id
  userId      String
  date        String
  tempMaxC    Float?
  tempMinC    Float?
  precipMm    Float?
  uvIndex     Float?
  weatherCode Int?
  lat         Float?
  lon         Float?
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model UserPreference {
  userId String
  key    String
  value  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

model CaffeineLog {
  id         String   @id @default(cuid())
  userId     String
  compound   String
  caffeineMg Int
  servings   Float    @default(1)
  loggedAt   DateTime @default(now()) @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt(sort: Desc)])
}

model TagAlias {
  userId      String
  tagTypeUuid String
  name        String

  @@id([userId, tagTypeUuid])
}

// ─── Lab Results (blood work) ─────────────────────────────────────────────────

model LabResult {
  id           String   @id @default(cuid())
  userId       String
  marker       String
  value        Float
  unit         String
  referenceMin Float?
  referenceMax Float?
  date         DateTime @db.Date
  notes        String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, marker])
  @@index([userId, date])
}

// ─── Body Measurements ────────────────────────────────────────────────────────

model BodyMeasurement {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime @db.Date
  weightKg   Float?
  waistCm    Float?
  hipsCm     Float?
  chestCm    Float?
  neckCm     Float?
  bodyFatPct Float?
  musclePct  Float?
  bmi        Float?
  notes      String?
  source     String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// ─── Habit Routines ───────────────────────────────────────────────────────────

model HabitRoutine {
  id        String   @id @default(cuid())
  userId    String
  name      String
  emoji     String   @default("⭐")
  habitIds  String[]
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Subscriptions (Stripe) ───────────────────────────────────────────────────

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  status               String    @default("free") // "free" | "active" | "canceled" | "past_due" | "trialing"
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── OwnTracks Location Points ───────────────────────────────────────────────

model LocationPoint {
  id        String   @id @default(cuid())
  userId    String
  lat       Float
  lng       Float
  accuracyM Int?
  altitudeM Float?
  speedKmh  Float?
  battPct   Int?
  trackedAt DateTime
  source    String   @default("owntracks")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, trackedAt])
}

// ─── WebAuthn Passkeys ────────────────────────────────────────────────────────

model Passkey {
  id           String   @id @default(cuid())
  userId       String
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  deviceType   String   @default("singleDevice")
  backedUp     Boolean  @default(false)
  transports   String[]
  name         String   @default("Passkey")
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Symptoms ────────────────────────────────────────────────────────────────

// How the user *feels*, as opposed to how their body performs. Everything else
// in this schema is a metric or an intake; nothing recorded whether the day
// involved a headache, nausea or brain fog — which is exactly the surface a
// medication's side effects show up on. Severity is 1-5; a day with no entry
// for a symptom counts as 0 in the correlation engine, so absence is data too.
model SymptomLog {
  id        String   @id @default(cuid())
  userId    String
  name      String // canonical-ish label, e.g. "Headache"
  severity  Int // 1-5: 1=barely there, 5=severe
  bodyPart  String? // optional location, for a future body map
  note      String?
  loggedAt  DateTime @default(now())
  day       String // YYYY-MM-DD in the user's timezone
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, day])
  @@index([userId, name])
}

// ─── Strava ───────────────────────────────────────────────────────────────────

model StravaToken {
  userId       String   @id
  accessToken  String
  refreshToken String
  expiresAt    BigInt
  athleteId    String?
  updatedAt    DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StravaActivity {
  id             String   @id @default(cuid())
  userId         String
  stravaId       String
  type           String
  name           String?
  distanceM      Float?
  movingTimeSec  Int
  elapsedTimeSec Int
  elevationM     Float?
  avgHR          Int?
  maxHR          Int?
  startDate      DateTime @db.Timestamptz
  day            String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stravaId])
  @@index([userId, day(sort: Desc)])
}

// ─── YNAB ────────────────────────────────────────────────────────────────────

model YnabToken {
  userId       String    @id
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime? @db.Timestamptz
  budgetId     String?
  budgetName   String?
  updatedAt    DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── User feedback ────────────────────────────────────────────────────────────

model UserFeedback {
  id        String   @id @default(cuid())
  userId    String
  message   String
  type      String   @default("suggestion")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A recurring dose the user intends to take. Adherence is never stored here —
// it's derived from the dose log (OuraTag), which is the single place a dose
// exists whether it came from the ring, a manual tap, or a reminder.
model MedSchedule {
  id         String   @id @default(cuid())
  userId     String
  name       String // display name, e.g. "Elicea 10 mg"
  dose       String? // free text, e.g. "1 tablet"
  /// Local times of day in HH:mm, e.g. ["08:00", "21:00"]
  times      String[]
  /// Days of the week (0 = Sunday). Empty means every day.
  daysOfWeek Int[]    @default([])
  active     Boolean  @default(true)
  remind     Boolean  @default(true)
  note       String?
  startDate  String? // YYYY-MM-DD, optional
  endDate    String? // YYYY-MM-DD, optional
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

// ─── Push notifications ──────────────────────────────────────────────────────

// A device's web-push registration. /api/push/subscribe used to create this
// table lazily with raw SQL, which meant every cron that pushes errored with
// `relation "PushSubscription" does not exist` until someone's first successful
// subscribe — which never happened. The build runs `prisma db push`, so
// declaring it here guarantees the table exists.
//
// Deliberately no relation to User: the raw SQL that reads and writes this
// table predates the model, and a lazily created copy of the table in an
// existing database has no foreign key for db push to reconcile.
model PushSubscription {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([userId])
}

// ─── Goals ────────────────────────────────────────────────────────────────────

// The targets the dashboard measures a day against.
//
// These used to be a JSON blob in a DailyNote row dated 0001-01-01 — a
// sentinel the /api/goals comment itself called "a workaround until a proper
// Goals table is added". Five different files parsed that blob with their own
// defaults, so a goal could mean one thing on the dashboard and another on the
// health page, and any feature iterating DailyNote met a JSON blob wearing a
// journal entry's clothes. Existing blobs migrate on first read.
model UserGoals {
  userId       String   @id
  sleepH       Float    @default(7.5)
  steps        Int      @default(8000)
  waterMl      Int      @default(2000)
  focusMin     Int      @default(90)
  habitsTarget Int      @default(100)
  readinessMin Int      @default(70)
  /// Caffeine, in milligrams per day — not millilitres of coffee.
  coffeeMax    Int      @default(400)
  weightKg     Float?
  heightCm     Float?
  birthYear    Int?
  sex          String?
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Self-experiments (N-of-1) ───────────────────────────────────────────────

// A correlation can only ever say "these move together". An experiment can say
// "this changed something", because the user decides what to do *before* seeing
// the outcome, and alternates on and off in blocks so time, weather, mood and
// everything else that drifts gets a chance to cancel out.
//
// One outcome is chosen up front. That single pre-registered question is what
// makes this stronger evidence than the 51-question correlation scan, which has
// to spend statistical power on false-discovery correction precisely because
// nobody chose its questions in advance.
model Experiment {
  id        String   @id @default(cuid())
  userId    String
  name      String // "Magnesium before bed"
  /// What the user does during an ON block, in their own words.
  action    String
  /// The measured thing being watched, e.g. "sleepScore" or "custom:<metricId>".
  outcome   String
  /// Length of one block in days. Blocks alternate ON/OFF.
  blockDays Int      @default(7)
  /// Total number of blocks; 4 gives the classic ABAB.
  blocks    Int      @default(4)
  /// Days to discard after each switch, for carry-over.
  washoutDays Int    @default(1)
  /// True when the first block is an ON block. Randomised at creation.
  startsOn  Boolean  @default(true)
  startDate String // YYYY-MM-DD, the user's local day
  status    String   @default("running") // running | completed | abandoned
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  days ExperimentDay[]

  @@index([userId, status])
}

// One row per day the user answered "did you do it?". Absent means unanswered,
// which the analysis treats as unknown — never as a silent yes or no.
model ExperimentDay {
  id           String   @id @default(cuid())
  experimentId String
  userId       String
  date         String // YYYY-MM-DD, local
  adhered      Boolean
  note         String?
  createdAt    DateTime @default(now())

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, date])
  @@index([userId, date])
}

// ─── Adopted shadow tables ───────────────────────────────────────────────────
//
// Every model below was, until now, a table created only by raw
// `CREATE TABLE IF NOT EXISTS` on the request path — invisible to this file,
// to the typed client, and to review. The build runs
// `prisma db push --accept-data-loss`, which treats any table not described
// here as an accident to remove: every deploy dropped all fifteen, and the
// raw DDL quietly recreated them empty the next time a request touched them.
// A Last.fm API key, a year of scrobbles, custom metrics with their whole
// history, blood pressure — gone on every push, which is why nobody ever
// caught it: the tables always existed by the time anyone looked.
//
// The shapes below are transcribed from that raw DDL, not from memory — and
// because the tables were recreated from the deployed code on every cycle,
// the code's DDL and the live database cannot have drifted apart. A model
// that disagreed with the live table would not fail, it would rewrite the
// table; that is why every column here matches the CREATE statement exactly,
// down to @db.Real vs Float and which columns carry no foreign key.
//
// The raw CREATE TABLE IF NOT EXISTS call sites are left in place: they
// no-op against the tables db push now maintains, and removing them is a
// separate cleanup with no urgency.

model BloodPressureLog {
  id        String   @id
  userId    String
  systolic  Int
  diastolic Int
  pulse     Int?
  loggedAt  DateTime @default(now()) @db.Timestamptz
  notes     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// No foreign key on userId, faithfully: the raw DDL never declared one, and
// adopting a table is not the moment to change its behaviour.
model BodyMeasurementLog {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId     String
  loggedAt   DateTime @default(now()) @db.Timestamptz
  waistCm    Float?   @db.Real
  chestCm    Float?   @db.Real
  hipsCm     Float?   @db.Real
  neckCm     Float?   @db.Real
  bicepCm    Float?   @db.Real
  bodyFatPct Float?   @db.Real
  notes      String?
}

model CustomMetric {
  id        String   @id
  userId    String
  name      String
  unit      String?
  type      String   @default("number")
  color     String   @default("#6366f1")
  emoji     String   @default("📊")
  minVal    Float?   @db.Real
  maxVal    Float?   @db.Real
  createdAt DateTime @default(now()) @db.Timestamptz

  user User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs CustomMetricLog[]

  @@index([userId])
}

model CustomMetricLog {
  id       String   @id
  userId   String
  metricId String
  date     DateTime @db.Date
  value    Float    @db.Real
  note     String?
  loggedAt DateTime @default(now()) @db.Timestamptz

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric CustomMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([metricId, date])
  @@index([userId, date])
}

model FcmToken {
  token     String   @id
  userId    String
  updatedAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GitHubProfile {
  userId      String   @id
  username    String
  accessToken String?
  updatedAt   DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// userId is the key but carries no foreign key — see BodyMeasurementLog.
model GocardlessConnection {
  userId        String   @id
  requisitionId String?
  accountId     String?
  accountName   String?
  currency      String?
  updatedAt     DateTime @default(now()) @db.Timestamptz
}

model LastfmKey {
  userId    String   @id
  apiKey    String
  username  String
  updatedAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LastfmLog {
  id           String  @id
  userId       String
  date         String
  tracksPlayed Int     @default(0)
  listeningMin Int     @default(0)
  topArtist    String?
  topTrack     String?
  // Added by ALTER, deliberately nullable with no default: null means "this
  // day was imported before late-evening tracks were counted", which must
  // stay distinguishable from a genuinely quiet evening's 0.
  lateTracks   Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model NewsletterSubscriber {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  email     String   @unique
  createdAt DateTime @default(now()) @db.Timestamp(6)
}

model RescuetimeKey {
  userId    String   @id
  apiKey    String
  updatedAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RescuetimeLog {
  id                String @id
  userId            String
  date              String
  productivityScore Int?
  totalActiveH      Float?
  productiveH       Float?
  neutralH          Float?
  distractingH      Float?
  topCategory       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// See GocardlessConnection — keyed by userId, no foreign key in the DDL.
model SaltedgeConnection {
  userId       String   @id
  customerId   String
  connectionId String?
  accountId    String?
  accountName  String?
  currency     String?
  updatedAt    DateTime @default(now()) @db.Timestamptz
}

model TogglToken {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String   @unique
  apiToken    String
  workspaceId Int?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// See GocardlessConnection — keyed by userId, no foreign key in the DDL.
model TruelayerToken {
  userId       String    @id
  accessToken  String
  refreshToken String?
  expiresAt    DateTime? @db.Timestamptz
  accountId    String?
  accountName  String?
  currency     String?
  updatedAt    DateTime  @default(now()) @db.Timestamptz
}

// How a stretch of time was travelled, from a source that actually knows.
//
// The day journey infers travel modes from GPS speed, and speed genuinely
// cannot tell a bus from a car. Two sources can do better and both land here:
// Google Timeline's activity segments (matched against transit-line maps, so
// they distinguish IN_BUS from IN_PASSENGER_VEHICLE — the one thing no phone
// sensor can) and Android's Activity Recognition transitions from the phone
// itself. lib/day-journeys overlays these onto inferred moves as "known".
model ActivitySpan {
  id     String   @id
  userId String
  start  DateTime @db.Timestamptz
  end    DateTime @db.Timestamptz
  /// lib/day-journeys TravelMode: walk|run|cycle|transit|drive|train|flight
  mode   String
  /// The recogniser could only say "in a vehicle" — bus vs car stays open,
  /// so the overlay refines the guess instead of asserting a mode.
  vehicleOnly Boolean @default(false)
  /// "timeline" (Google export) or "phone" (Activity Recognition)
  source String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, start])
}
