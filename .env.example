# Copy to .env.local for development. Production values live in Vercel →
# Settings → Environment Variables. Variables marked REQUIRED IN PROD make
# the app refuse to do the corresponding job rather than doing it unprotected.

# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Get from: https://neon.tech → your project → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─── Auth.js v5 ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
# Your app URL (use http://localhost:3000 for local dev)
AUTH_URL="http://localhost:3000"
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"
# Public app URL (OAuth callbacks, emails, the MCP server's own address)
NEXT_PUBLIC_APP_URL="https://yourdomain.vercel.app"

# ─── Scheduled jobs — REQUIRED IN PROD ───────────────────────────────────────
# Every /api/cron/* route refuses to run unless the caller presents this as
# "Authorization: Bearer <CRON_SECRET>". Unset = every cron answers 503.
# Set the same value as the CRON_SECRET repository secret used by
# .github/workflows/*-cron.yml, and Vercel sends it automatically for
# vercel.json crons. Generate with: openssl rand -hex 32
CRON_SECRET=""

# ─── Owner / admin gating ────────────────────────────────────────────────────
# Comma-separated emails allowed to run /api/admin/* (empty = nobody).
ADMIN_EMAILS=""
OWNER_EMAIL=""
# Where feedback and newsletter sign-ups are forwarded.
FEEDBACK_NOTIFY_EMAIL=""

# ─── Password sign-in (Android WebView + Play Store review) ─────────────────
# Optional. Both trios are independent; an unset trio is simply not accepted.
CREDENTIALS_USERNAME=""
CREDENTIALS_PASSWORD=""
CREDENTIALS_EMAIL=""
DEMO_USERNAME=""
DEMO_PASSWORD=""
DEMO_EMAIL=""

# ─── Anthropic ───────────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Weekly review, digests, reports, monthly export. Verify your sending domain
# in Resend; the shared onboarding@resend.dev sender only delivers to the
# account owner.
RESEND_API_KEY=""
# The sender on a domain you verified in Resend. Unset falls back to the
# sandbox sender, which only ever reaches the Resend account owner.
EMAIL_FROM="Emergenthealth <hello@yourdomain.example>"

# ─── Push notifications ──────────────────────────────────────────────────────
# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:you@example.com"
# Firebase Cloud Messaging for the Android app — the service-account JSON, as one line
FCM_SERVICE_ACCOUNT=""

# ─── Telegram companion (optional) ───────────────────────────────────────────
# See TELEGRAM_SETUP.md. The webhook refuses every call unless this matches
# the secret_token given to setWebhook — unset = the webhook is closed.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# ─── Integrations (each optional; the matching page stays disconnected) ─────
OURA_CLIENT_ID=""
OURA_CLIENT_SECRET=""
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
YNAB_CLIENT_ID=""
YNAB_CLIENT_SECRET=""
TRUELAYER_CLIENT_ID=""
TRUELAYER_CLIENT_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── Held-back features (see src/lib/features.ts) ────────────────────────────
# Actual Budget (finances fallback)
ACTUAL_SERVER_URL=""
ACTUAL_SERVER_PASSWORD=""
ACTUAL_BUDGET_SYNC_ID=""
# Smart home bridge URL (docker/ac-bridge) — the bridge's own GREE_* device
# settings live in docker/ac-bridge/.env, never here and never in git.
EWPE_API_URL=""

# ─── Feature flags ───────────────────────────────────────────────────────────
# Comma-separated keys to force on (see src/lib/features.ts)
NEXT_PUBLIC_ENABLED_FEATURES=""
