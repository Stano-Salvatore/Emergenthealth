# Copy to .env (never commit it) and fill in. Every variable the app reads is
# described in the repository's root .env.example. Copy across what you had in
# Vercel → emergenthealth → Settings → Environment Variables, then change the
# two addresses below.

# The public HTTPS address of this server, no trailing slash, e.g.
# https://homeserver.your-tailnet.ts.net. AUTH_URL is set from it in compose.yml.
NEXT_PUBLIC_APP_URL=""

# The same values Vercel had.
DATABASE_URL=""
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
CRON_SECRET=""
ANTHROPIC_API_KEY=""

# Add the rest of what Vercel had (Oura, Strava, Resend, VAPID, FCM, Telegram…)
# below, one per line, the same way.

# Only with the Cloudflare Tunnel option (docs/self-hosting.md).
CLOUDFLARE_TUNNEL_TOKEN=""
